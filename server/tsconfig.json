{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "types": ["node"]
  },
  "include": ["src", "src/types.d.ts", "src/ambient.d.ts"],
  "exclude": ["node_modules", "dist"]
}